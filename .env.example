# Sanity — leave unset during initial development; the site renders with
# empty event/directory sections until a project exists (see README).
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production

# Google Forms iframe embed URL for the "Coros Associados" registration
# form (must be a form owned by the institutional Google Workspace account,
# not a personal one — see README "Coros associados").
PUBLIC_GOOGLE_FORM_COROS_URL=

# Contact form (src/pages/api/contact.ts) — email delivery via Resend.
# Get a key at https://resend.com after verifying the corosportugal.pt domain.
RESEND_API_KEY=
CONTACT_FORM_TO_EMAIL=geral@corosportugal.pt
