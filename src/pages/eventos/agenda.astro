---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EventListSection from '../../components/EventListSection.astro';
import { useTranslations } from '../../i18n/utils';
import { getEventosAgenda } from '../../lib/sanity';

const lang = 'pt' as const;
const t = useTranslations(lang);
const eventos = await getEventosAgenda();
---

<BaseLayout lang={lang} title={t('events.agenda.title')} description={t('events.agenda.intro')}>
  <EventListSection
    lang={lang}
    title={t('events.agenda.title')}
    intro={t('events.agenda.intro')}
    emptyText={t('events.agenda.empty')}
    eventos={eventos}
  />
</BaseLayout>
