---
import BaseLayout from '../layouts/BaseLayout.astro';
import { useTranslations } from '../i18n/utils';
import { getPaginaInstitucional } from '../lib/sanity';
import { blocksToParagraphs } from '../lib/portableText';
import { institutionalFallbackPt } from '../content/institutional';

const lang = 'pt' as const;
const t = useTranslations(lang);
const pagina = await getPaginaInstitucional();

const quemSomos = pagina?.quemSomos
  ? blocksToParagraphs(pagina.quemSomos)
  : institutionalFallbackPt.quemSomos;
const oQueFazemos = pagina?.oQueFazemos
  ? blocksToParagraphs(pagina.oQueFazemos)
  : institutionalFallbackPt.oQueFazemos;
const visao = pagina?.visao ? blocksToParagraphs(pagina.visao) : institutionalFallbackPt.visao;
const missao = pagina?.missao ? blocksToParagraphs(pagina.missao) : institutionalFallbackPt.missao;
const valores = pagina?.valores?.length ? pagina.valores : institutionalFallbackPt.valores;
---

<BaseLayout lang={lang} title={t('about.title')} description={quemSomos[0]}>
  <section class="hero">
    <div class="container">
      <h1>{t('about.title')}</h1>
    </div>
  </section>

  <section class="section prose">
    <div class="container">
      <h2>{t('about.whoWeAre')}</h2>
      {quemSomos.map((p) => <p>{p}</p>)}

      <h2>{t('about.whatWeDo')}</h2>
      {oQueFazemos.map((p) => <p>{p}</p>)}

      <h2>{t('about.vision')}</h2>
      {visao.map((p) => <p>{p}</p>)}

      <h2>{t('about.mission')}</h2>
      {missao.map((p) => <p>{p}</p>)}

      <h2>{t('about.values')}</h2>
      <div class="card-grid">
        {
          valores.map((valor) => (
            <div class="card">
              <h3>{valor.nome}</h3>
              <p>{valor.descricao}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
